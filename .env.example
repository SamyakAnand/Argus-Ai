NEXUS_ENV=development
NEXUS_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///data/nexus.db
REDIS_URL=redis://redis:6379/0

# Single server-side generation provider. Never expose this key to the browser.
EURI_API_KEY=

# Knowledge answer synthesis is opt-in. When enabled with a configured provider,
# requests may be sent to that provider and may incur cost depending on its terms.
ARGUS_KNOWLEDGE_GENERATION_ENABLED=false
ARGUS_KNOWLEDGE_DIR=data/argus-knowledge
ARGUS_KNOWLEDGE_MAX_PASSAGES=8
ARGUS_KNOWLEDGE_CONTEXT_CHARS=9000
# Optional local-only token map: {"local-development":"replace-this-with-a-random-token"}
# Keep empty in shared files. Knowledge routes fail closed until configured.
ARGUS_KNOWLEDGE_DEV_TOKENS_JSON=
# Optional API auth verification settings. Never commit real Clerk keys.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3002

MAX_UPLOAD_MB=15
NEXT_PUBLIC_DEMO_MODE=true
