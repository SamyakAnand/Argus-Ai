NEXUS_ENV=development
NEXUS_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///data/nexus.db
REDIS_URL=redis://redis:6379/0

# Optional Model Providers (OpenAI, Gemini, Anthropic, or Local Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

MAX_UPLOAD_MB=15
NEXT_PUBLIC_DEMO_MODE=true
